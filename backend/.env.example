# ==============================================================================
# BitElevate PR Review Copilot - Configuration Template
# Copy this file to .env and configure the values for your local environment.
# DO NOT commit real secrets or .env to version control.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=false
SECRET_KEY=change-this-in-production-to-a-secure-random-string
MENTOR_TOKEN=mentor-secret-token-change-in-production

# Database Configuration (SQLite default for MVP)
DATABASE_URL=sqlite:///./bitelevate_copilot.db

# LLM Provider Configuration
# Supported providers: openai, mock
LLM_PROVIDER=mock
LLM_API_KEY=mock-api-key-for-development
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2500

# GitHub Integration
# Required for fetching PR diffs and posting approved reviews
GITHUB_TOKEN=ghp_mock_token_for_local_testing
GITHUB_WEBHOOK_SECRET=mock-webhook-secret-string

# Review Copilot Guardrails
MAX_DIFF_CHARACTERS=50000
MAX_DIFF_FILES=25
MAX_COMMENTS_PER_REVIEW=15
ENABLE_PROMPT_INJECTION_DEFENSE=true
